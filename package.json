{
    "name": "robago",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "pnpm@10.28.0",
    "engines": {
        "node": ">=20",
        "pnpm": ">=9"
    },
    "scripts": {
        "dev": "pnpm --parallel --filter=./apps/* run dev",
        "dev:backend": "pnpm --filter @robago/backend run dev",
        "dev:frontend": "pnpm --filter @robago/frontend run dev",
        "build": "pnpm --filter @robago/shared run build && pnpm --filter @robago/backend run build && pnpm --filter @robago/frontend run build",
        "build:shared": "pnpm --filter @robago/shared run build",
        "build:backend": "pnpm --filter @robago/shared run build && pnpm --filter @robago/backend run build",
        "build:frontend": "pnpm --filter @robago/frontend run build",
        "package:backend": "node scripts/packageBackend.js",
        "package:frontend": "rm -rf apps/frontend/dist robago-frontend-dist.zip && pnpm run build:frontend && (cd apps/frontend/dist && zip -r -q ../../../robago-frontend-dist.zip . .htaccess)",
        "lint": "pnpm -r run lint",
        "typecheck": "pnpm --filter @robago/shared run build && pnpm -r run typecheck",
        "format": "prettier --write .",
        "test": "pnpm --filter @robago/backend run test",
        "seed": "pnpm --filter @robago/backend run seed",
        "seed:staff": "pnpm --filter @robago/backend run seed:staff",
        "seed:expenses": "pnpm --filter @robago/backend run seed:expenses",
        "seed:accounts": "pnpm --filter @robago/backend run seed:accounts",
        "seed:schools": "pnpm --filter @robago/backend run seed:schools",
        "seed:all": "pnpm --filter @robago/backend run seed:all",
        "test:db": "pnpm --filter @robago/backend run test:db",
        "migrate:roles": "pnpm --filter @robago/backend run migrate:roles",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx,json,css,md}": [
            "prettier --write"
        ]
    },
    "devDependencies": {
        "husky": "^9.1.7",
        "lint-staged": "^17.4.1",
        "prettier": "^3.9.6",
        "typescript": "~6.0.2"
    }
}