        "lint": "eslint ."
    },
    "dependencies": {
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.9.0",
        "globals": "^17.11.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.67.0"
    }
}
