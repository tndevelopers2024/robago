{
    "name": "@robago/backend",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -b",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "seed": "tsx src/scripts/seed.ts",
        "seed:staff": "tsx src/scripts/seedStaff.ts",
        "seed:expenses": "tsx src/scripts/seedExpenses.ts",
        "seed:accounts": "tsx src/scripts/seedAccounts.ts",
        "seed:schools": "tsx src/scripts/seedSchools.ts",
        "migrate:roles": "tsx src/scripts/migrateRoles.ts",
        "test": "vitest run"
    },
    "dependencies": {
        "@robago/shared": "workspace:*",
        "bcryptjs": "^3.0.2",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^5.1.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.9.5",
        "nodemailer": "^10.6.0",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cookie-parser": "^1.4.8",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^24.13.3",
        "@types/nodemailer": "^8.0.2",
        "@types/supertest": "^6.0.2",
        "eslint": "^10.9.0",
        "globals": "^17.11.0",
        "supertest": "^7.0.0",
        "tsx": "^4.19.2",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.67.0",
        "vitest": "^3.0.5"
    }
}
