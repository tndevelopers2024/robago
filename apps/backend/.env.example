PORT=3000
MONGO_URI=mongodb://localhost:27017/robago
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:5173
# COOKIE_DOMAIN=your-domain.com

# --- Email reminders to debtors (optional) -----------------------------------------------------
# Fill these in to let the app send payment-reminder emails. Leave SMTP_HOST empty to switch email off.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=accounts@robago.com
# SMTP_PASS=your-app-password
# EMAIL_FROM="Robago Accounts <accounts@robago.com>"
# EMAIL_REPLY_TO=accounts@robago.com
# COMPANY_NAME=Robago
